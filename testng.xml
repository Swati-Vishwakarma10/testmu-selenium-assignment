<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TestMu Cloud Suite" parallel="tests" thread-count="2">
    <test name="Chrome on Windows">
        <parameter name="browser" value="Chrome"/>
        <parameter name="platform" value="Windows 11"/>
        <parameter name="version" value="latest"/>
        <classes>
            <class name="tests.SimpleFormTest"/>
            <class name="tests.SliderTest"/>
            <class name="tests.InputFormTest"/>
        </classes>
    </test>
    <test name="Firefox on Windows">
        <parameter name="browser" value="Firefox"/>
        <parameter name="platform" value="Windows 11"/>
        <parameter name="version" value="latest"/>
        <classes>
            <class name="tests.SimpleFormTest"/>
            <class name="tests.SliderTest"/>
            <class name="tests.InputFormTest"/>
        </classes>
    </test>
</suite>